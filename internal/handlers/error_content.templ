package handlers

templ errorContent(code, message string) {
	<h1 style="font-size:2.5rem;margin-bottom:0.1em">{ code }</h1>
	<p class="error">{ message }</p>
	if code == "404 Not Found" {
		<p>Either the note was hidden, never existed, or you mistyped the path. Try the <a href="/feed">feed</a> or <a href="/search">search</a>.</p>
	} else if code == "403 Forbidden" {
		<p>You're not allowed to do that. If you think this is wrong, sign in or check your handle.</p>
	} else if code == "500 Internal Server Error" {
		<p>Something on our side broke. The error has been logged. Try again in a moment.</p>
	}
	<p style="margin-top:1.5rem"><a href="/">Home</a> · <a href="/feed">Feed</a></p>
}
