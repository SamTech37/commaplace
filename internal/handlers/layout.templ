package handlers

import "commonplace/internal/auth"
import "commonplace/internal/config"

// ChromeProps carries the site chrome every page shares (nav, current user,
// theme). Built once per request by Server.chrome; individual pages don't
// set these fields themselves.
type ChromeProps struct {
	User        *auth.User
	Site        config.Site
	Nav         config.Nav
	Theme       string
	SearchQuery string
}

func pageClassAttr(extra string) string {
	if extra == "" {
		return "page"
	}
	return "page " + extra
}

func avatarURL(handle string) string {
	return "/u/" + handle + "/avatar.png"
}

templ defaultMeta(c ChromeProps) {
	<meta property="og:site_name" content={ c.Site.Title }/>
	<meta property="og:title" content={ c.Site.Title }/>
	<meta property="og:description" content={ c.Site.Description }/>
	<meta property="og:type" content="website"/>
	<meta name="twitter:card" content="summary"/>
}

// Layout is the page shell: doctype, head, topbar, footer. meta may be nil
// (falls back to defaultMeta); contents is the page body rendered inside
// <main class="content">.
templ Layout(c ChromeProps, title, pageClass string, meta, contents templ.Component) {
	<!doctype html>
	<html
		lang="zh-Hant"
		if c.Theme != "" {
			data-theme-server={ c.Theme }
			data-theme={ c.Theme }
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<script>
      (function () {
        var html = document.documentElement;
        if (html.getAttribute("data-theme-server")) return;
        var pref = null;
        try {
          pref = localStorage.getItem("theme");
        } catch (e) {}
        var resolved = pref || "auto";
        if (resolved === "auto") {
          resolved = matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
        }
        html.setAttribute("data-theme", resolved);
      })();
      (function () {
        var v = null;
        try {
          v = localStorage.getItem("motion");
        } catch (e) {}
        if (v === "reduced" || v === "full")
          document.documentElement.setAttribute("data-motion", v);
      })();
      (function () {
        try {
          var s = localStorage.getItem("reader-size");
          var f = localStorage.getItem("reader-font");
          if (s && s !== "m")
            document.documentElement.setAttribute("data-reader-size", s);
          if (f && f !== "serif")
            document.documentElement.setAttribute("data-reader-font", f);
        } catch (e) {}
      })();
    </script>
			<title>{ title }</title>
			if meta != nil {
				@meta
			} else {
				@defaultMeta(c)
			}
			<link rel="icon" type="image/svg+xml" href="/assets/comma_mascot_logo.svg"/>
			<link rel="stylesheet" href={ templ.URL(assetURL("fonts/tc/result.css")) }/>
			<link rel="stylesheet" href={ templ.URL(assetURL("style.css")) }/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous"/>
			<script src={ assetURL("htmx.min.js") } defer></script>
			<script src={ assetURL("copy.js") } defer></script>
			<script src={ assetURL("share.js") } defer></script>
			<script src={ assetURL("d3-force.min.js") } defer></script>
			<script src={ assetURL("graph.js") } defer></script>
			<script src={ assetURL("reveal.js") } defer></script>
			<script src={ assetURL("reader.js") } defer></script>
			<script src={ assetURL("rsvp.js") } defer></script>
			<script src={ assetURL("palette.js") } defer></script>
			<script src={ assetURL("opencc-toggle.js") } defer></script>
			<script src={ assetURL("prefs.js") } defer></script>
			<script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" crossorigin="anonymous" defer></script>
			<script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js" defer></script>
			<script>
      document.addEventListener("DOMContentLoaded", function () {
        if (window.katex) {
          document.querySelectorAll(".math-inline").forEach(function (el) {
            var src = el.textContent.replace(/^\$|\$$/g, "");
            try {
              el.innerHTML = katex.renderToString(src, {
                displayMode: false,
                throwOnError: false,
              });
            } catch (e) {}
          });
          document.querySelectorAll(".math-block").forEach(function (el) {
            var src = el.textContent;
            try {
              el.innerHTML = katex.renderToString(src, {
                displayMode: true,
                throwOnError: false,
              });
            } catch (e) {}
          });
        }
        if (window.mermaid) {
          var mt =
            document.documentElement.getAttribute("data-theme") === "light"
              ? "default"
              : "dark";
          mermaid.initialize({ startOnLoad: true, theme: mt });
        }
      });
    </script>
		</head>
		<body>
			<a class="skip-link" href="#main-content">跳到主要內容</a>
			<div class={ pageClassAttr(pageClass) }>
				<header class="topbar">
					<a class="brand" href="/" title="回到首頁">
						<img src="/assets/comma_mascot_logo.svg" class="brand-logo" alt=""/>
						<span class="brand-name">{ c.Site.Title }</span>
					</a>
					<form class="search-form" method="GET" action="/search" role="search">
						<input
							type="search"
							name="q"
							placeholder="搜尋… (Ctrl/Cmd + K)"
							value={ c.SearchQuery }
							aria-label="搜尋筆記"
						/>
						<button
							type="button"
							id="palette-btn"
							class="icon-btn palette-btn"
							aria-label="搜尋"
							title="搜尋 (Ctrl/Cmd + K)"
						>
							<svg
								viewBox="0 0 24 24"
								width="18"
								height="18"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								aria-hidden="true"
							>
								<circle cx="11" cy="11" r="7"></circle>
								<path d="M20 20l-3.5-3.5"></path>
							</svg>
						</button>
					</form>
					<nav class="nav" aria-label="主要導覽">
						<div class="nav-links">
							if c.User != nil {
								<a href="/write" title="寫一篇新筆記">{ c.Nav.Write }</a>
								<a href="/feed" title="看大家的最新筆記">{ c.Nav.Feed }</a>
								<a href="/graph" title="筆記之間的關係圖譜">{ c.Nav.Graph }</a>
								<a href="/random" title="隨機跳到一篇筆記">漫遊</a>
							} else {
								<a href="/feed" title="看大家的最新筆記">{ c.Nav.Feed }</a>
								<a href="/graph" title="筆記之間的關係圖譜">{ c.Nav.Graph }</a>
								<a href="/random" title="隨機跳到一篇筆記">漫遊</a>
							}
						</div>
						if c.User != nil {
							<details class="action-menu user-menu">
								<summary
									class="avatar"
									style={ "background-color:" + avatarColor(c.User.Handle) }
									aria-haspopup="menu"
									aria-expanded="false"
									aria-label="帳號與偏好設定"
									title={ "@" + c.User.Handle }
								>
									<img class="avatar-img" src={ avatarURL(c.User.Handle) } alt="" onerror="this.remove()"/>
									<span class="avatar-initial">{ avatarInitial(c.User.Handle) }</span>
								</summary>
								<div class="action-menu-list prefs-panel">
									@prefRows()
									<div class="action-menu-sep"></div>
									<a href={ templ.URL("/" + c.User.Handle) } title="你的個人頁">個人頁</a>
									<form method="POST" action="/logout" class="inline-form">
										<button type="submit" class="action-menu-danger" title="登出目前帳號">
											{ c.Nav.Logout }
										</button>
									</form>
								</div>
							</details>
						} else {
							<details class="action-menu prefs-menu">
								<summary class="icon-btn" aria-haspopup="menu" aria-expanded="false" aria-label="偏好設定" title="偏好設定">設</summary>
								<div class="action-menu-list prefs-panel">
									@prefRows()
								</div>
							</details>
						}
						<details class="action-menu mobile-menu">
							<summary aria-label="選單" title="更多">≡</summary>
							<div class="mobile-menu-list action-menu-list">
								if c.User != nil {
									<a href="/write" title="寫一篇新筆記">{ c.Nav.Write }</a>
									<a href="/feed" title="大家的最新筆記">{ c.Nav.Feed }</a>
									<a href="/graph" title="筆記之間的連結圖">{ c.Nav.Graph }</a>
									<a href="/random" title="隨機跳到一篇筆記">漫遊</a>
								} else {
									<a href="/feed" title="大家的最新筆記">{ c.Nav.Feed }</a>
									<a href="/graph" title="筆記之間的連結圖">{ c.Nav.Graph }</a>
									<a href="/random" title="隨機跳到一篇筆記">漫遊</a>
								}
							</div>
						</details>
						if c.User == nil {
							<a href="/login" class="nav-login" title="登入或註冊">{ c.Nav.Login }</a>
						}
					</nav>
				</header>
				<main id="main-content" class="content" tabindex="-1">
					@contents
				</main>
				<footer class="site-footer">
					<span>© { c.Site.Title }</span>
					<span class="crumb-sep">·</span>
					<a href="/terms">服務條款</a>
					<span class="crumb-sep">·</span>
					<a href="/privacy">隱私政策</a>
				</footer>
				<nav class="mobile-dock" aria-label="手機主要導覽">
					<a href="/feed"><span aria-hidden="true">⌂</span><span>動態</span></a>
					if c.User != nil {
						<a href="/write"><span aria-hidden="true">＋</span><span>寫作</span></a>
					} else {
						<a href="/graph"><span aria-hidden="true">⌘</span><span>圖譜</span></a>
					}
					<button type="button" id="mobile-palette-btn"><span aria-hidden="true">⌕</span><span>搜尋</span></button>
					if c.User != nil {
						<a href={ templ.URL("/" + c.User.Handle) }><span aria-hidden="true">◉</span><span>我的</span></a>
					} else {
						<a href="/login"><span aria-hidden="true">→</span><span>登入</span></a>
					}
				</nav>
			</div>
		</body>
	</html>
}

// prefRows renders the three display preferences shared by the account menu
// (signed in) and the settings menu (signed out). The segmented controls reuse
// the reader-* styles so they match the note reading-options popover.
templ prefRows() {
	<div class="reader-row">
		<span class="reader-label">外觀</span>
		<div class="reader-seg" role="group" aria-label="外觀">
			<button type="button" class="reader-opt" data-pref-set="theme" data-val="auto" aria-pressed="false" title="跟隨系統設定">系統</button>
			<button type="button" class="reader-opt" data-pref-set="theme" data-val="light" aria-pressed="false" title="一律淺色">淺色</button>
			<button type="button" class="reader-opt" data-pref-set="theme" data-val="dark" aria-pressed="false" title="一律深色">深色</button>
		</div>
	</div>
	<div class="reader-row">
		<span class="reader-label">動畫</span>
		<div class="reader-seg" role="group" aria-label="動畫">
			<button type="button" class="reader-opt" data-pref-set="motion" data-val="system" aria-pressed="false" title="跟隨系統的動畫偏好">系統</button>
			<button type="button" class="reader-opt" data-pref-set="motion" data-val="full" aria-pressed="false" title="一律播放完整動畫">完整</button>
			<button type="button" class="reader-opt" data-pref-set="motion" data-val="reduced" aria-pressed="false" title="減少動畫">減量</button>
		</div>
	</div>
	<div class="reader-row">
		<span class="reader-label">文字</span>
		<div class="reader-seg" role="group" aria-label="文字">
			<button type="button" class="reader-opt" data-pref-set="script" data-val="orig" aria-pressed="false" title="顯示作者原本的字體">原</button>
			<button type="button" class="reader-opt" data-pref-set="script" data-val="cn" aria-pressed="false" title="轉為简体显示">简</button>
			<button type="button" class="reader-opt" data-pref-set="script" data-val="tw" aria-pressed="false" title="轉為繁體顯示">繁</button>
		</div>
	</div>
}
