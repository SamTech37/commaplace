package handlers

import "commonplace/internal/auth"
import "commonplace/internal/config"

// ChromeProps carries the site chrome every page shares (nav, current user,
// theme). Built once per request by Server.chrome; individual pages don't
// set these fields themselves.
type ChromeProps struct {
	User        *auth.User
	Site        config.Site
	Nav         config.Nav
	Theme       string
	SearchQuery string
}

func pageClassAttr(extra string) string {
	if extra == "" {
		return "page"
	}
	return "page " + extra
}

func avatarURL(handle string) string {
	return "/u/" + handle + "/avatar.png"
}

templ defaultMeta(c ChromeProps) {
	<meta property="og:site_name" content={ c.Site.Title }/>
	<meta property="og:title" content={ c.Site.Title }/>
	<meta property="og:description" content={ c.Site.Description }/>
	<meta property="og:type" content="website"/>
	<meta name="twitter:card" content="summary"/>
}

// Layout is the page shell: doctype, head, topbar, footer. meta may be nil
// (falls back to defaultMeta); contents is the page body rendered inside
// <main class="content">.
templ Layout(c ChromeProps, title, pageClass string, meta, contents templ.Component) {
	<!doctype html>
	<html
		lang="zh-Hant"
		if c.Theme != "" {
			data-theme-server={ c.Theme }
			data-theme={ c.Theme }
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<script>
      (function () {
        var html = document.documentElement;
        if (html.getAttribute("data-theme-server")) return;
        var pref = null;
        try {
          pref = localStorage.getItem("theme");
        } catch (e) {}
        var resolved = pref || "auto";
        if (resolved === "auto") {
          resolved = matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
        }
        html.setAttribute("data-theme", resolved);
      })();
      (function () {
        var v = null;
        try {
          v = localStorage.getItem("motion");
        } catch (e) {}
        if (v === "reduced")
          document.documentElement.setAttribute("data-motion", "reduced");
      })();
      (function () {
        try {
          var s = localStorage.getItem("reader-size");
          var f = localStorage.getItem("reader-font");
          if (s && s !== "m")
            document.documentElement.setAttribute("data-reader-size", s);
          if (f && f !== "serif")
            document.documentElement.setAttribute("data-reader-font", f);
        } catch (e) {}
      })();
    </script>
			<title>{ title }</title>
			if meta != nil {
				@meta
			} else {
				@defaultMeta(c)
			}
			<link rel="icon" type="image/svg+xml" href="/assets/comma_mascot_logo.svg"/>
			<link rel="stylesheet" href="/assets/fonts/tc/result.css"/>
			<link rel="stylesheet" href="/assets/style.css"/>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous"/>
			<script src="/assets/htmx.min.js" defer></script>
			<script src="/assets/copy.js" defer></script>
			<script src="/assets/share.js" defer></script>
			<script src="/assets/d3-force.min.js" defer></script>
			<script src="/assets/graph.js" defer></script>
			<script src="/assets/reveal.js" defer></script>
			<script src="/assets/reader.js" defer></script>
			<script src="/assets/rsvp.js" defer></script>
			<script src="/assets/palette.js" defer></script>
			<script src="/assets/opencc-toggle.js" defer></script>
			<script src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js" crossorigin="anonymous" defer></script>
			<script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js" defer></script>
			<script>
      document.addEventListener("DOMContentLoaded", function () {
        if (window.katex) {
          document.querySelectorAll(".math-inline").forEach(function (el) {
            var src = el.textContent.replace(/^\$|\$$/g, "");
            try {
              el.innerHTML = katex.renderToString(src, {
                displayMode: false,
                throwOnError: false,
              });
            } catch (e) {}
          });
          document.querySelectorAll(".math-block").forEach(function (el) {
            var src = el.textContent;
            try {
              el.innerHTML = katex.renderToString(src, {
                displayMode: true,
                throwOnError: false,
              });
            } catch (e) {}
          });
        }
        if (window.mermaid) {
          var mt =
            document.documentElement.getAttribute("data-theme") === "light"
              ? "default"
              : "dark";
          mermaid.initialize({ startOnLoad: true, theme: mt });
        }
        // Theme toggle (icon button: flips light <-> dark)
        var tg = document.getElementById("theme-toggle");
        var mobileTg = document.getElementById("mobile-theme-toggle");
        if (tg) {
          var syncIcon = function () {
            var t =
              document.documentElement.getAttribute("data-theme") === "light"
                ? "light"
                : "dark";
            // Same convention as 動 / 原: the glyph names the current state.
            tg.textContent = t === "light" ? "明" : "暗";
            tg.setAttribute(
              "aria-label",
              t === "light" ? "切換到夜間" : "切換到日間",
            );
            tg.setAttribute(
              "title",
              t === "light" ? "切換到夜間" : "切換到日間",
            );
            if (mobileTg) {
              var mobileLabel =
                t === "light" ? "切換到夜間" : "切換到日間";
              mobileTg.textContent = mobileLabel;
              mobileTg.setAttribute("aria-label", mobileLabel);
            }
          };
          syncIcon();
          tg.addEventListener("click", function () {
            var cur =
              document.documentElement.getAttribute("data-theme") === "light"
                ? "light"
                : "dark";
            var next = cur === "light" ? "dark" : "light";
            document.documentElement.setAttribute("data-theme", next);
            syncIcon();
            try {
              localStorage.setItem("theme", next);
            } catch (e) {}
            try {
              fetch("/settings/theme", {
                method: "POST",
                headers: {
                  "Content-Type": "application/x-www-form-urlencoded",
                },
                body: "theme=" + encodeURIComponent(next),
                credentials: "same-origin",
              });
            } catch (e) {}
          });
          if (mobileTg) {
            mobileTg.addEventListener("click", function () {
              tg.click();
            });
          }
        }
        // Motion toggle (icon button: flips reduced <-> normal, localStorage only)
        var mg = document.getElementById("motion-toggle");
        var mobileMg = document.getElementById("mobile-motion-toggle");
        if (mg) {
          var syncMotion = function () {
            var on =
              document.documentElement.getAttribute("data-motion") ===
              "reduced";
            mg.setAttribute("aria-pressed", on ? "true" : "false");
            mg.setAttribute("aria-label", on ? "恢復動畫" : "減少動畫");
            mg.setAttribute("title", on ? "恢復動畫" : "減少動畫");
            if (mobileMg) {
              mobileMg.textContent = on ? "恢復動畫" : "減少動畫";
              mobileMg.setAttribute("aria-pressed", on ? "true" : "false");
            }
          };
          syncMotion();
          mg.addEventListener("click", function () {
            var html = document.documentElement;
            var reduced = html.getAttribute("data-motion") !== "reduced";
            if (reduced) html.setAttribute("data-motion", "reduced");
            else html.removeAttribute("data-motion");
            try {
              localStorage.setItem("motion", reduced ? "reduced" : "normal");
            } catch (e) {}
            syncMotion();
          });
          if (mobileMg) {
            mobileMg.addEventListener("click", function () {
              mg.click();
            });
          }
        }
      });
    </script>
		</head>
		<body>
			<a class="skip-link" href="#main-content">跳到主要內容</a>
			<div class={ pageClassAttr(pageClass) }>
				<header class="topbar">
					<a class="brand" href="/" title="回到首頁">
						<img src="/assets/comma_mascot_logo.svg" class="brand-logo" alt=""/>
						<span class="brand-name">{ c.Site.Title }</span>
					</a>
					<form class="search-form" method="GET" action="/search" role="search">
						<input
							type="search"
							name="q"
							placeholder="搜尋… (Ctrl/Cmd + K)"
							value={ c.SearchQuery }
							aria-label="搜尋筆記"
						/>
						<button
							type="button"
							id="palette-btn"
							class="icon-btn palette-btn"
							aria-label="搜尋"
							title="搜尋 (Ctrl/Cmd + K)"
						>
							<svg
								viewBox="0 0 24 24"
								width="18"
								height="18"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								aria-hidden="true"
							>
								<circle cx="11" cy="11" r="7"></circle>
								<path d="M20 20l-3.5-3.5"></path>
							</svg>
						</button>
					</form>
					<nav class="nav" aria-label="主要導覽">
						<div class="nav-links">
							if c.User != nil {
								<a href="/write" title="寫一篇新筆記">{ c.Nav.Write }</a>
								<a href="/feed" title="看大家的最新筆記">{ c.Nav.Feed }</a>
								<a href="/graph" title="筆記之間的關係圖譜">{ c.Nav.Graph }</a>
								<a href="/me/calendar" title="用月曆看自己的筆記">{ c.Nav.Calendar }</a>
								<a href="/random" title="隨機跳到一篇筆記">漫遊</a>
								<form method="POST" action="/logout" class="inline-form">
									<button type="submit" class="link-btn" title="登出目前帳號">
										{ c.Nav.Logout }
									</button>
								</form>
							} else {
								<a href="/feed" title="看大家的最新筆記">{ c.Nav.Feed }</a>
								<a href="/graph" title="筆記之間的關係圖譜">{ c.Nav.Graph }</a>
								<a href="/random" title="隨機跳到一篇筆記">漫遊</a>
							}
						</div>
						<button
							type="button"
							id="theme-toggle"
							class="icon-btn topbar-preference"
							aria-label="切換主題"
							title="切換深色／淺色主題"
						></button>
						<button
							type="button"
							id="motion-toggle"
							class="icon-btn topbar-preference"
							aria-pressed="false"
							aria-label="減少動畫"
							title="減少動畫"
						>
							動
						</button>
						<button
							type="button"
							id="script-toggle"
							class="icon-btn topbar-preference"
							aria-label="切換為简体显示"
							title="切換為简体显示"
						>
							原
						</button>
						if c.User != nil {
							<a
								class="avatar"
								href={ templ.URL("/" + c.User.Handle) }
								style={ "background-color:" + avatarColor(c.User.Handle) }
								title={ "@" + c.User.Handle }
							>
								<img
									class="avatar-img"
									src={ avatarURL(c.User.Handle) }
									alt=""
									onerror="this.remove()"
								/>
								<span class="avatar-initial">{ avatarInitial(c.User.Handle) }</span>
							</a>
						}
						<details class="action-menu mobile-menu">
							<summary aria-label="選單" title="更多">≡</summary>
							<div class="mobile-menu-list action-menu-list">
								if c.User != nil {
									<a href="/write" title="寫一篇新筆記">{ c.Nav.Write }</a>
									<a href="/feed" title="大家的最新筆記">{ c.Nav.Feed }</a>
									<a href="/graph" title="筆記之間的連結圖">{ c.Nav.Graph }</a>
									<a href="/me/calendar" title="用月曆看自己的筆記">{ c.Nav.Calendar }</a>
									<a href="/random" title="隨機跳到一篇筆記">漫遊</a>
									<div class="mobile-menu-sep"></div>
									<form method="POST" action="/logout" class="inline-form">
										<button type="submit" class="link-btn" title="登出目前帳號">
											{ c.Nav.Logout }
										</button>
									</form>
								} else {
									<a href="/feed" title="大家的最新筆記">{ c.Nav.Feed }</a>
									<a href="/graph" title="筆記之間的連結圖">{ c.Nav.Graph }</a>
									<a href="/random" title="隨機跳到一篇筆記">漫遊</a>
								}
								<div class="mobile-menu-sep"></div>
								<div class="mobile-preferences" role="group" aria-label="顯示設定">
									<button type="button" id="mobile-theme-toggle">切換外觀</button>
									<button type="button" id="mobile-motion-toggle" aria-pressed="false">減少動畫</button>
									<button type="button" id="mobile-script-toggle">切換繁簡</button>
								</div>
							</div>
						</details>
						if c.User == nil {
							<a href="/login" class="nav-login" title="登入或註冊">{ c.Nav.Login }</a>
						}
					</nav>
				</header>
				<main id="main-content" class="content" tabindex="-1">
					@contents
				</main>
				<footer class="site-footer">
					<span>© { c.Site.Title }</span>
					<span class="crumb-sep">·</span>
					<a href="/terms">服務條款</a>
					<span class="crumb-sep">·</span>
					<a href="/privacy">隱私政策</a>
				</footer>
				<nav class="mobile-dock" aria-label="手機主要導覽">
					<a href="/feed"><span aria-hidden="true">⌂</span><span>動態</span></a>
					if c.User != nil {
						<a href="/write"><span aria-hidden="true">＋</span><span>寫作</span></a>
					} else {
						<a href="/graph"><span aria-hidden="true">⌘</span><span>圖譜</span></a>
					}
					<button type="button" id="mobile-palette-btn"><span aria-hidden="true">⌕</span><span>搜尋</span></button>
					if c.User != nil {
						<a href={ templ.URL("/" + c.User.Handle) }><span aria-hidden="true">◉</span><span>我的</span></a>
					} else {
						<a href="/login"><span aria-hidden="true">→</span><span>登入</span></a>
					}
				</nav>
			</div>
		</body>
	</html>
}
