package handlers

import "fmt"

templ calendarGridView(handle string, g calendarGridProps) {
	<div class="calendar-page">
		<header class="calendar-head">
			<a class="calendar-nav" href={ templ.URL("/" + handle + "?view=calendar&m=" + g.PrevMonth) } aria-label="前一個月">‹</a>
			<h2 class="calendar-month">{ g.MonthLabel }</h2>
			<a class="calendar-nav" href={ templ.URL("/" + handle + "?view=calendar&m=" + g.NextMonth) } aria-label="下一個月">›</a>
			if g.ThisMonth != g.PrevMonth && g.ThisMonth != g.NextMonth {
				<a class="calendar-today" href={ templ.URL("/" + handle + "?view=calendar") }>今天</a>
			}
		</header>
		<div class="calendar-grid">
			for _, name := range g.DayNames {
				<div class="calendar-dayname">{ name }</div>
			}
			for _, day := range g.Days {
				<div class={ calendarCellClass(day) }>
					<div class="calendar-cell-day">{ fmt.Sprint(day.Day) }</div>
					if len(day.Notes) > 0 {
						<ul class="calendar-cell-notes">
							for _, n := range day.Notes {
								<li><a href={ templ.URL(n.URL) } title={ n.Title }>{ n.Title }</a></li>
							}
						</ul>
					}
				</div>
			}
		</div>
	</div>
}
