package handlers

templ deskPage(userID, handle string) {
	<script src={ assetURL("desk-model.js") } defer></script>
	<script src={ assetURL("desk.js") } defer></script>
	<div id="comma-desk" data-user-id={ userID } data-handle={ handle }>
		<aside class="desk-sidebar" aria-label="工作桌導覽">
			<nav aria-label="收藏"><button type="button" data-desk-url="/me/saved">我的收藏</button></nav>
			<div class="desk-sidebar-heading">
				<h2>我的空間</h2>
				<button type="button" id="desk-search-toggle" aria-label="尋找文章" title="尋找文章" aria-expanded="false" aria-controls="desk-note-search">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg>
				</button>
			</div>
			<label class="desk-search-label" for="desk-note-search">尋找文章</label>
			<input id="desk-note-search" type="search" autocomplete="off" hidden/>
			<div id="desk-my-notes"></div>
			<button type="button" id="desk-more-notes" hidden>載入更多</button>
			<button type="button" class="desk-new-note" data-desk-new aria-label="新增文章" title="新增文章">＋</button>
		</aside>
		<section class="desk-workspace" aria-label="工作桌">
			<div class="desk-strip">
				<nav class="desk-tabs" aria-label="已開啟的內容"></nav>
				<button type="button" data-desk-scroll="-1" aria-label="桌面向左移動">‹</button>
				<button type="button" data-desk-scroll="1" aria-label="桌面向右移動">›</button>
				<button type="button" id="desk-add" aria-label="新增" title="新增" aria-haspopup="dialog">＋</button>
			</div>
			<div class="desk-board"><div class="desk-plane"></div></div>
			<div class="desk-feedback">
				<span id="desk-status" role="status" aria-live="polite"></span>
				<button type="button" id="desk-retry" hidden>重試儲存</button>
				<button type="button" id="desk-reload" hidden>使用雲端桌面</button>
				<button type="button" id="desk-overwrite" hidden>保留這張桌面</button>
			</div>
		</section>
		<dialog id="desk-add-dialog" aria-label="新增">
			<div class="desk-dialog-heading"><button type="button" data-desk-dismiss aria-label="關閉新增內容">×</button></div>
			<button type="button" data-desk-url="/feed">探索 Feed</button>
			<button type="button" data-desk-url="/me/saved">我的收藏</button>
			<button type="button" data-desk-new aria-label="新增文章">＋</button>
			<input id="desk-open-search" type="search" aria-label="尋找自己的文章"/>
			<div id="desk-open-results"></div>
		</dialog>
		<noscript><p>工作桌需要 JavaScript。你仍可以<a href="/feed">瀏覽 Feed</a>或<a href="/write">編寫文章</a>。</p></noscript>
	</div>
}
