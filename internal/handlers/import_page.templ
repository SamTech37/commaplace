package handlers

type ImportPageProps struct {
	Error string
}

templ importPage(props ImportPageProps) {
	<h1>匯入筆記</h1>
	if props.Error != "" {
		<p class="error">{ props.Error }</p>
	}
	<form method="post" action="/import" enctype="multipart/form-data">
		<label>
			Markdown 檔（可多選，最多 10 個）
			<input
				type="file"
				name="files"
				accept=".md,text/markdown"
				multiple
				required
			/>
		</label>
		<div style="display: flex; gap: 1em; align-items: center; margin-top: 0.5em">
			<button type="submit" class="action-btn primary">匯入</button>
			<a href="/write" class="note-meta">直接寫一篇新的 →</a>
		</div>
	</form>
}
