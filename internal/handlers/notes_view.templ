package handlers

import (
	"context"
	"io"
	"strconv"
	"time"
)

// NoteListView is the shared view-model for every note-listing surface
// (feed/tag/search/profile/saved, and the hover-preview endpoint): one data
// source (a []feedCard query), one rendering.
type NoteListView struct {
	Cards       []feedCard
	Layout      string // registry key into cardRenderers; "" defaults to "masonry"
	OlderURL    string // "" = no infinite scroll (end marker shown instead)
	Empty       templ.Component // shown (inside a <p class="note-meta">) when len(Cards) == 0
	GroupByDate bool // profile's timeline mode: a date header above each run of same-day cards
}

// cardRenderers maps a layout name to the component that renders one card in
// that layout. Adding a layout later is one function + one entry here — no
// handler changes. Two are registered: "masonry" (feed, hover-preview — the
// only surface that was ever masonry before this substrate existed) and
// "list" (tag/search/saved/profile — plain rows, same as before).
var cardRenderers = map[string]func(feedCard) templ.Component{
	"masonry": masonryCard,
	"list":    listCard,
}

// renderCards renders every card in view.Cards through view.Layout's
// registered renderer (falling back to masonry for an empty/unknown key).
// When GroupByDate is set, each run of same-day cards is wrapped in a
// timeline-group (date rail on the left, cards stacked on the right) — the
// same markup the standalone /me/calendar timeline view used before it was
// folded into the profile page. An infinite-scroll continuation re-derives
// its own runs independently, so a run split across a page boundary becomes
// two adjacent groups with the same date label rather than one merged group.
func renderCards(view NoteListView) templ.Component {
	render, ok := cardRenderers[view.Layout]
	if !ok {
		render = cardRenderers["masonry"]
	}
	return templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		if !view.GroupByDate {
			for _, c := range view.Cards {
				if err := render(c).Render(ctx, w); err != nil {
					return err
				}
			}
			return nil
		}
		lastDate := ""
		groupOpen := false
		for _, c := range view.Cards {
			d := time.Unix(c.UpdatedAt, 0).In(time.Local).Format("01/02")
			if d != lastDate {
				if groupOpen {
					if _, err := io.WriteString(w, `</div></div>`); err != nil {
						return err
					}
				}
				if _, err := io.WriteString(w, `<div class="timeline-group"><div class="timeline-date">`+d+`</div><div class="timeline-cards">`); err != nil {
					return err
				}
				lastDate = d
				groupOpen = true
			}
			if err := render(c).Render(ctx, w); err != nil {
				return err
			}
		}
		if groupOpen {
			if _, err := io.WriteString(w, `</div></div>`); err != nil {
				return err
			}
		}
		return nil
	})
}

// emptyText is a plain-text NoteListView.Empty for surfaces with no link in
// their empty-state message.
templ emptyText(msg string) {
	{ msg }
}

templ notesSentinel(olderURL string) {
	if olderURL != "" {
		<div id="notes-sentinel" class="feed-sentinel" aria-label="載入中" hx-get={ olderURL } hx-trigger="revealed" hx-target=".notes-items" hx-swap="beforeend">
			<span></span><span></span><span></span>
		</div>
	} else {
		<div id="notes-sentinel" class="feed-end">— 沒有更多了 —</div>
	}
}

templ notesSentinelOOB(olderURL string) {
	if olderURL != "" {
		<div id="notes-sentinel" hx-swap-oob="outerHTML" class="feed-sentinel" hx-get={ olderURL } hx-trigger="revealed" hx-target=".notes-items" hx-swap="beforeend">載入更多…</div>
	} else {
		<div id="notes-sentinel" hx-swap-oob="outerHTML" class="feed-end">— 沒有更多了 —</div>
	}
}

// notesView is the full render: empty state, or the card grid + sentinel.
templ notesView(view NoteListView) {
	if len(view.Cards) == 0 {
		<p class="note-meta">@view.Empty</p>
	} else {
		<div class={ notesItemsClass(view) }>
			@renderCards(view)
		</div>
		@notesSentinel(view.OlderURL)
	}
}

// notesItemsClass picks the card-container class, matching renderCards'
// own fallback rule exactly (unrecognized/empty Layout defaults to
// masonry): "masonry" lays cards out in CSS columns (feed/preview); "list"
// is a plain vertical stack — .note-card is block-level, no column CSS.
// GroupByDate adds "timeline" (flex column, gap between groups) since
// renderCards wraps its output in timeline-group divs instead of bare cards.
func notesItemsClass(view NoteListView) string {
	class := "notes-items"
	if view.Layout != "list" {
		class = "masonry " + class
	}
	if view.GroupByDate {
		class = "timeline " + class
	}
	return class
}

// notesFragment is the HTMX infinite-scroll response: new cards appended via
// hx-swap="beforeend" into .notes-items, plus a replacement OOB sentinel.
templ notesFragment(view NoteListView) {
	@renderCards(view)
	@notesSentinelOOB(view.OlderURL)
}

// listCard is a plain title/excerpt/meta row — the layout every list-shaped
// surface (tag/search/saved/profile) used before this substrate existed;
// masonry is feed's alone (and the hover-preview it shares a card with).
templ listCard(c feedCard) {
	if c.IsDraft {
		<div class="note-card-row">
			<input type="checkbox" name="ids" value={ c.NoteID.String() } aria-label="選取這篇草稿"/>
			@listCardLink(c)
		</div>
	} else {
		@listCardLink(c)
	}
}

templ listCardLink(c feedCard) {
	<a class="note-card" href={ templ.URL(c.URL) } data-reveal>
		<div class="note-title">{ c.Title }</div>
		if c.SnippetHTML != nil {
			<div class="note-excerpt">@c.SnippetHTML</div>
		} else if c.Excerpt != "" {
			<div class="note-excerpt">{ c.Excerpt }</div>
		}
		<div class="note-foot">
			if c.AuthorHandle != "" {
				<span class="meta-handle">{ "@" + c.AuthorHandle }</span> · { c.UpdatedRel }
			} else {
				{ c.UpdatedRel }
			}
		</div>
	</a>
}

templ masonryCard(c feedCard) {
	@masonryCardLink(c)
}

templ masonryCardLink(c feedCard) {
	<a class={ "masonry-card", "variant-" + c.Variant } href={ templ.URL(c.URL) } data-reveal>
		<div class="card-title">{ c.Title }</div>
		if c.ImageURL != "" {
			<img class="card-image" src={ c.ImageURL } alt="" loading="lazy"/>
		}
		if c.Variant == "list" {
			<ul class="card-list">
				for _, item := range c.ListItems {
					<li>{ item }</li>
				}
			</ul>
		} else if c.Variant == "quote" {
			<blockquote class="card-quote">{ c.Quote }</blockquote>
		} else if c.Variant == "links" {
			<div class="card-connections">
				for i, chip := range c.LinkChips {
					if i < 2 {
						<div class="connection">→ { chip }</div>
					}
				}
				if len(c.LinkChips) > 2 {
					<div class="connection-more">+ { strconv.Itoa(len(c.LinkChips) - 2) } 篇相關筆記</div>
				}
			</div>
		}
		if c.SnippetHTML != nil {
			<div class="card-excerpt">@c.SnippetHTML</div>
		} else if c.Excerpt != "" {
			<div class="card-excerpt">{ c.Excerpt }</div>
		}
		if len(c.Tags) > 0 {
			<div class="card-tags">
				for _, t := range c.Tags {
					<span class="card-tag">#{ t }</span>
				}
			</div>
		}
		<div class="card-meta">
			<span class="meta-handle">{ "@" + c.AuthorHandle }</span>
			<span class="meta-spacer"></span>
			if c.LikeCount > 0 {
				<span class="meta-like">♡ { strconv.Itoa(c.LikeCount) }</span>
			}
			if c.LinkCount > 0 {
				<span class="meta-links">→ { strconv.Itoa(c.LinkCount) }</span>
			}
			if c.CrossCount > 0 {
				<span class="meta-cross">↝ { strconv.Itoa(c.CrossCount) }</span>
			}
		</div>
	</a>
}
