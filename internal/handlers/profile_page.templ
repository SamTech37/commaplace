package handlers

import (
	"strconv"

	"github.com/google/uuid"
)

type ProfilePageProps struct {
	Handle         string
	ProfileID      uuid.UUID
	Mode           string // "timeline" (default), "calendar", or "graph"
	View           NoteListView
	Calendar       *calendarGridProps
	Tab            string
	IsSelf         bool
	ViewerLoggedIn bool
	Following      bool
	FollowerCount  int
	FollowingCount int
	NoteCount      int
	EstYear        int
	Pinned         *pinnedNote
	Home           profileHome
}

templ profileNotesList(p ProfilePageProps) {
	<div id="notes-list" data-reveal-group>
		@notesView(p.View)
	</div>
}

templ showcaseTypeOption(value string, label string, current string) {
	if current == value {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

templ profilePage(p ProfilePageProps) {
	<header class="vault-masthead" data-reveal>
		<div class="profile-header">
			<img class="avatar-img-lg" src={ avatarURL(p.Handle) } alt={ "@" + p.Handle } onerror="this.style.display='none'"/>
			<h1 class="vault-name">{ "@" + p.Handle }</h1>
		</div>
		<div class="vault-meta">
			if p.EstYear > 0 {
				Est. { strconv.Itoa(p.EstYear) } ·
			}
			{ strconv.Itoa(p.NoteCount) } entries
		</div>
	</header>
	<div class="note-meta profile-meta">
		@followCountMenu(p.Handle, "followers", p.FollowerCount)
		<span class="crumb-sep">·</span>
		@followCountMenu(p.Handle, "following", p.FollowingCount)
		if p.IsSelf {
			<span class="crumb-sep">·</span>
			<a href="/me/avatar">編輯大頭貼</a>
			<span class="crumb-sep">·</span>
			<a href="/write">寫筆記</a>
			<span class="crumb-sep">·</span>
			<details class="handle-edit">
				<summary>改用戶名</summary>
				<form method="POST" action="/settings/handle" class="handle-form">
					<span class="handle-at">{ "@" }</span>
					<input
						type="text"
						name="handle"
						value={ p.Handle }
						pattern="[a-z0-9][a-z0-9-]{0,28}[a-z0-9]"
						maxlength="30"
						required
						aria-label="新的用戶名"
						title="小寫英數字與連字號，2–30 字"
					/>
					<button type="submit" class="handle-save">儲存</button>
				</form>
			</details>
		}
	</div>
	if p.ViewerLoggedIn && !p.IsSelf {
		<div class="profile-follow">
			@followForm(p.ProfileID, p.Following)
		</div>
	}
	if p.IsSelf {
		<details class="profile-home-editor">
			<summary>布置小屋</summary>
			<form method="POST" action="/settings/profile" class="profile-home-form" data-profile-home-form data-profile-handle={ p.Handle }>
				<label>
					<span>門牌</span>
					<input type="text" name="profile_title" value={ p.Home.Title } maxlength="80" placeholder="未完成想法的溫室" data-profile-home-title-input/>
				</label>
				<label>
					<span>小屋導覽</span>
					<textarea name="profile_bio" maxlength="1200" rows="6" placeholder={ "## 起點\n最近我把念頭放在這幾個房間。" } data-profile-home-body-input>{ p.Home.BodyMD }</textarea>
				</label>
				<div class="profile-showcase-editor-list" data-showcase-editor-list>
					for i, showcase := range profileShowcaseEditorSlots(p.Home.Showcases) {
						<fieldset class="profile-showcase-edit" data-showcase-row>
							<legend>{ "展示櫃 " + strconv.Itoa(i+1) }</legend>
							<div class="profile-showcase-edit-controls">
								<label>
									<span>類型</span>
									<select name="showcase_type" data-showcase-type aria-label={ "展示櫃 " + strconv.Itoa(i+1) + " 類型" }>
										@showcaseTypeOption("", "不顯示", showcase.Type)
										@showcaseTypeOption(profileShowcaseNote, "手選筆記", showcase.Type)
										@showcaseTypeOption(profileShowcaseTag, "主題房間", showcase.Type)
										@showcaseTypeOption(profileShowcaseText, "自由文字", showcase.Type)
									</select>
								</label>
								<label>
									<span>標題</span>
									<input type="text" name="showcase_title" value={ showcase.Title } maxlength="80" placeholder="最近常走的路" data-showcase-title/>
								</label>
								<label>
									<span>引用</span>
									<input type="text" name="showcase_ref" value={ showcase.Ref } maxlength="120" placeholder="writing-is-thinking" data-showcase-ref/>
								</label>
								<div class="profile-showcase-row-actions">
									<button type="button" aria-label="上移展示櫃" title="上移" data-showcase-up>↑</button>
									<button type="button" aria-label="下移展示櫃" title="下移" data-showcase-down>↓</button>
									<button type="button" aria-label="清空展示櫃" title="清空" data-showcase-clear>×</button>
								</div>
							</div>
							<label class="profile-showcase-body-edit">
								<span>補一句</span>
								<textarea name="showcase_body" maxlength="700" rows="2" placeholder="這格可以放一段給訪客看的旁白。" data-showcase-body>{ showcase.BodyMD }</textarea>
							</label>
						</fieldset>
					}
				</div>
				<button type="submit">儲存布置</button>
			</form>
		</details>
	}
	if p.IsSelf || p.Pinned != nil || p.Home.HasDisplay() {
		<section id="profile-home" class="profile-home" data-reveal data-profile-home-preview>
			<div class="profile-home-head">
				<div>
					<div class="profile-home-kicker">小屋入口</div>
					<h2 data-profile-home-title data-fallback={ "進入 @" + p.Handle + " 的小屋" }>{ profileHomeTitle(p.Home, p.Handle) }</h2>
				</div>
				<a class="profile-home-map" href={ templ.URL("/" + p.Handle + "?view=graph") }>圖譜</a>
			</div>
			if p.Home.BodyHTML != "" || p.IsSelf {
				<div class="profile-home-body" data-profile-home-body>
					if p.Home.BodyHTML != "" {
						@templ.Raw(string(p.Home.BodyHTML))
					}
				</div>
			}
			<div class="profile-home-grid" data-profile-home-grid>
				if p.Pinned != nil {
					<a class="profile-home-pin" href={ templ.URL(p.Pinned.URL) }>
						<span>入口筆記</span>
						<strong>{ p.Pinned.Title }</strong>
					</a>
				}
				if len(p.Home.Showcases) > 0 {
					<div class="profile-showcases" data-profile-showcases>
						for _, showcase := range p.Home.Showcases {
							<article class={ "profile-showcase", templ.KV("is-empty", !showcase.HasNote && showcase.Type != profileShowcaseText) } data-profile-showcase data-showcase-key={ profileShowcaseKey(showcase) }>
								<div class="profile-showcase-head">
									<span data-showcase-kind>{ profileShowcaseKindLabel(showcase.Type) }</span>
									<h3 data-profile-showcase-title>{ profileShowcaseTitle(showcase) }</h3>
								</div>
								if showcase.BodyHTML != "" || p.IsSelf {
									<div class="profile-showcase-body" data-profile-showcase-body>
										if showcase.BodyHTML != "" {
											@templ.Raw(string(showcase.BodyHTML))
										}
									</div>
								}
								if showcase.HasNote {
									<a class="profile-showcase-note" href={ templ.URL(showcase.NoteURL) }>
										<strong>{ showcase.NoteTitle }</strong>
										if showcase.IsDraft && p.IsSelf {
											<em>尚未公開</em>
										}
										if showcase.Excerpt != "" {
											<span>{ showcase.Excerpt }</span>
										}
									</a>
								} else if showcase.Type != profileShowcaseText && p.IsSelf {
									<div class="profile-showcase-note is-empty">
										<strong>{ profileShowcaseEmptyText(showcase) }</strong>
									</div>
								}
							</article>
						}
					</div>
				}
			</div>
		</section>
	}
	<div class="calendar-view-toggle" style="margin-top: 1.5em;">
		<a class={ "calendar-view-tab", templ.KV("active", p.Mode != "calendar" && p.Mode != "graph") } href={ templ.URL("/" + p.Handle) }>時間軸</a>
		<a class={ "calendar-view-tab", templ.KV("active", p.Mode == "calendar") } href={ templ.URL("/" + p.Handle + "?view=calendar") }>月曆</a>
		<a class={ "calendar-view-tab", templ.KV("active", p.Mode == "graph") } href={ templ.URL("/" + p.Handle + "?view=graph") }>圖譜</a>
	</div>
	if p.Mode == "calendar" {
		@calendarGridView(p.Handle, *p.Calendar)
	} else if p.Mode == "graph" {
		<div id="graph-wrap" data-graph-source={ "/api/graph?user=" + p.Handle } style="margin-top:1em">
			<canvas id="graph-canvas"></canvas>
			<div class="graph-empty" hidden>還沒有筆記可以畫。</div>
			<div class="graph-tooltip" hidden></div>
		</div>
		<script src={ assetURL("linkpreview.js") } defer></script>
	} else {
		if p.IsSelf {
			<nav class="feed-tabs profile-manager-tabs" style="margin-top: 1em;">
				<a href={ templ.URL("/" + p.Handle + "?tab=all") } class={ "feed-tab", templ.KV("active", p.Tab == "all") }>全部</a>
				<a href={ templ.URL("/" + p.Handle) } class={ "feed-tab", templ.KV("active", p.Tab != "drafts" && p.Tab != "all") }>公開</a>
				<a href={ templ.URL("/" + p.Handle + "?tab=drafts") } class={ "feed-tab", templ.KV("active", p.Tab == "drafts") }>隱藏・草稿</a>
			</nav>
		} else {
			<div class="profile-notes-heading" style="margin-top:1em">最近的筆記</div>
		}
		if p.IsSelf {
			<form method="post" action="/api/notes/manage" id="note-manager">
				<input type="hidden" name="tab" value={ p.Tab }/>
				<div class="note-manager-toolbar">
					<button type="button" data-select="loaded">全選已載入</button>
					<button type="button" data-select="none">全部取消勾選</button>
					<label><input type="checkbox" name="scope" value="all" id="select-all-notes"/> 選取整個篩選結果（含未載入）</label>
					<span id="note-selection-count" role="status" aria-live="polite">已選 0 篇</span>
					<button type="submit" name="action" value="publish" data-bulk disabled>設為公開</button>
					<button type="submit" name="action" value="hide" data-bulk disabled>設為隱藏</button>
					<button type="submit" name="action" value="delete" data-bulk disabled>刪除所選</button>
				</div>
				@profileNotesList(p)
			</form>
			<script src={ assetURL("note-manager.js") } defer></script>
		} else {
			@profileNotesList(p)
		}
	}
	if p.IsSelf {
		<script src={ assetURL("profile-home.js") } defer></script>
	}
}
