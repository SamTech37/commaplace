package handlers

import "strconv"

templ importBatchPage(items []batchItem) {
	<script src={ assetURL("import-batch.js") } defer></script>
	<header class="batch-head">
		<h1>批次匯入 <span class="batch-count">{ strconv.Itoa(len(items)) } 篇</span></h1>
		<p class="batch-hint note-meta">沒按 <code>儲存</code> 的不會留下，重整就沒了。</p>
		<div class="batch-toolbar">
			<button type="button" class="action-btn primary" data-batch-save-all>全部儲存</button>
			<a class="action-btn" href="/import">重新選檔</a>
		</div>
	</header>
	<div class="batch-list">
		for _, item := range items {
			<section class="batch-item" data-idx={ strconv.Itoa(item.Idx) } data-status="pending">
				<form
					class="batch-item-form"
					hx-post="/import/save-one"
					hx-target="closest .batch-item"
					hx-swap="outerHTML"
				>
					<label class="batch-field">
						<span class="batch-field-label">標題</span>
						<input
							type="text"
							name="title"
							value={ item.Title }
							required
							autocomplete="off"
						/>
					</label>
					<div class="batch-body-row">
						<textarea
							class="batch-body"
							name="body_md"
							rows="14"
							hx-post="/preview"
							hx-trigger="input changed delay:400ms"
							hx-target="next .batch-preview"
							hx-swap="innerHTML"
						>{ item.Body }</textarea>
						<div class="batch-preview article-body"></div>
					</div>
					<label class="batch-field">
						<span class="batch-field-label">標籤（以逗號分隔）</span>
						<input type="text" name="tags" value={ item.Tags } autocomplete="off"/>
					</label>
					<div class="batch-item-actions">
						<button type="submit" class="action-btn primary">儲存這篇</button>
						<button type="button" class="action-btn" data-batch-discard>捨棄</button>
						<span class="batch-item-status"></span>
					</div>
				</form>
			</section>
		}
	</div>
	<footer class="batch-foot">
		<button type="button" class="action-btn primary" data-batch-save-all>全部儲存</button>
	</footer>
}
