package handlers

templ avatarPickerStrip(cat string, ids []string) {
	<section class="picker-row">
		<h2 class="picker-label">
			switch cat {
				case "face":
					臉
				case "eyes":
					眼睛
				case "mouth":
					嘴巴
				case "acc":
					配件
			}
		</h2>
		<div class="picker-strip" data-cat={ cat }>
			for _, id := range ids {
				<button type="button" class="picker-thumb" data-id={ id }>
					<img src={ "/assets/avatar/" + cat + "/" + id + ".png" } alt={ cat + " " + id }/>
				</button>
			}
		</div>
	</section>
}

templ avatarBuilderPage(choice AvatarChoice) {
	<div class="avatar-builder" data-reveal>
		<h1 style="margin-bottom:1.5em">選擇你的大頭貼</h1>
		<form method="POST" action="/me/avatar" id="avatar-form" class="avatar-builder-grid">
			<div class="avatar-preview-col">
				<div class="avatar-preview" aria-label="預覽">
					<img id="avatar-face" alt="" src={ "/assets/avatar/face/" + choice.Face + ".png" }/>
					<img id="avatar-eyes" alt="" src={ "/assets/avatar/eyes/" + choice.Eyes + ".png" }/>
					<img id="avatar-mouth" alt="" src={ "/assets/avatar/mouth/" + choice.Mouth + ".png" }/>
					<img id="avatar-acc" alt="" src={ "/assets/avatar/acc/" + choice.Acc + ".png" }/>
				</div>
				<button type="submit" class="avatar-save-btn">儲存大頭貼</button>
			</div>
			<div class="avatar-picker-col">
				<input type="hidden" name="face" id="in-face" value={ choice.Face }/>
				<input type="hidden" name="eyes" id="in-eyes" value={ choice.Eyes }/>
				<input type="hidden" name="mouth" id="in-mouth" value={ choice.Mouth }/>
				<input type="hidden" name="acc" id="in-acc" value={ choice.Acc }/>
				@avatarPickerStrip("face", AvatarParts.Face)
				@avatarPickerStrip("eyes", AvatarParts.Eyes)
				@avatarPickerStrip("mouth", AvatarParts.Mouth)
				@avatarPickerStrip("acc", AvatarParts.Acc)
			</div>
		</form>
	</div>
	<script>
(function () {
  var pathFor = {
    face:  '/assets/avatar/face/',
    eyes:  '/assets/avatar/eyes/',
    mouth: '/assets/avatar/mouth/',
    acc:   '/assets/avatar/acc/',
  };
  var preview = {
    face:  document.getElementById('avatar-face'),
    eyes:  document.getElementById('avatar-eyes'),
    mouth: document.getElementById('avatar-mouth'),
    acc:   document.getElementById('avatar-acc'),
  };
  var hidden = {
    face:  document.getElementById('in-face'),
    eyes:  document.getElementById('in-eyes'),
    mouth: document.getElementById('in-mouth'),
    acc:   document.getElementById('in-acc'),
  };

  function highlight(cat) {
    var current = hidden[cat].value;
    document
      .querySelector('.picker-strip[data-cat="' + cat + '"]')
      .querySelectorAll('.picker-thumb')
      .forEach(function (btn) {
        btn.classList.toggle('is-selected', btn.dataset.id === current);
      });
  }

  ['face', 'eyes', 'mouth', 'acc'].forEach(function (cat) {
    highlight(cat);
    var strip = document.querySelector('.picker-strip[data-cat="' + cat + '"]');
    strip.addEventListener('click', function (e) {
      var btn = e.target.closest('.picker-thumb');
      if (!btn) return;
      var id = btn.dataset.id;
      hidden[cat].value = id;
      preview[cat].src = pathFor[cat] + id + '.png';
      highlight(cat);
    });
  });
})();
	</script>
}
