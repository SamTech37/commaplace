package handlers

import "net/url"
import gotempl "github.com/a-h/templ"

type loginProps struct {
	Sent         bool
	Error        string
	Email        string
	Next         string
	OAuthEnabled bool
}

func loginGoogleHref(next string) gotempl.SafeURL {
	if next == "" {
		return gotempl.URL("/auth/google")
	}
	return gotempl.URL("/auth/google?next=" + url.QueryEscape(next))
}

templ loginPage(props loginProps) {
	<div class="login-wrap" data-reveal>
		<div style="text-align:center; margin-bottom: 2rem;">
			<div style="font-size: 3rem; font-weight: 200; letter-spacing: -0.05em; line-height: 1; margin-bottom: 0.5rem; font-family: var(--font-serif);">,</div>
			<h1 style="font-size: 1.5rem; font-weight: 700; margin: 0 0 0.3em; letter-spacing: -0.02em;">
				if props.Sent {
					郵件已送出
				} else {
					登入
				}
			</h1>
			if !props.Sent {
				<p style="color: var(--text-3); font-size: 0.9rem; margin: 0; font-family: var(--font-sans);">輸入信箱，我們寄連結給你</p>
			}
		</div>
		if props.Sent {
			<p class="flash">連結已寄出，15 分鐘內有效。</p>
			<p style="text-align:center; margin-top: 1.5rem; font-family: var(--font-sans); font-size: 0.9rem;"><a href="/login">重新寄送</a></p>
		} else {
			if props.Error != "" {
				<p class="error">{ props.Error }</p>
			}
			if props.OAuthEnabled {
				<a class="btn-google" href={ loginGoogleHref(props.Next) }>
					<svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
						<path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908c1.702-1.567 2.684-3.875 2.684-6.615Z" fill="#4285F4"></path>
						<path d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18Z" fill="#34A853"></path>
						<path d="M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332Z" fill="#FBBC05"></path>
						<path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 6.29C4.672 4.163 6.656 3.58 9 3.58Z" fill="#EA4335"></path>
					</svg>
					Continue with Google
				</a>
				<p class="login-divider">或</p>
			}
			<form method="POST" action="/login">
				<label style="gap: 0.4rem;">
					<span style="font-size: 0.8rem; color: var(--text-3); font-family: var(--font-sans); font-weight: 500; letter-spacing: 0.02em; text-transform: uppercase;">信箱</span>
					<input type="email" name="email" required autofocus value={ props.Email } placeholder="you@example.com" style="font-size: 1rem; padding: 0.75em 1em; border-radius: var(--r-btn);"/>
				</label>
				if props.Next != "" {
					<input type="hidden" name="next" value={ props.Next }/>
				}
				<button type="submit" style="width: 100%; justify-content: center; display: flex; padding: 0.75em 1em; font-size: 1rem; border-radius: var(--r-btn); margin-top: 0.25rem;">
					送出登入連結
				</button>
			</form>
		}
	</div>
}
