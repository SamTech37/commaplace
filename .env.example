# Copy to .env and adjust. main.go reads these via os.Getenv.
# Anything left blank falls back to a sensible dev default.

# Postgres connection string.
DATABASE_URL=postgres://commaplace:commaplace@localhost:5432/commaplace?sslmode=disable

# Listen address. ":8080" by default.
ADDR=:8080

# HMAC secret for session cookies. If empty, server reads/writes
# .session_secret (gitignored) so dev sessions survive restarts.
SESSION_SECRET=

# SMTP for magic-link emails. If SMTP_HOST is empty, magic links
# are written to stdout instead — perfect for local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=commaplace <noreply@example.com>

# Public base URL used to build magic-link URLs. Defaults to
# http://localhost:8080 when empty.
BASE_URL=

# Google OAuth. Both set = "Continue with Google" shows up on /login;
# either blank = the button stays hidden and magic links are the only way in.
# Register BASE_URL + /auth/google/callback as an authorized redirect URI
# in the Google Cloud console, or the callback is rejected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# User handle that gets /admin/reports + the ability to hide notes.
# Empty disables admin entirely. Lower-case the handle.
ADMIN_HANDLE=

# Set to "1" to expose /_test/markdown (debug-only routes) and verbose
# error pages. Leave unset in any deploy reachable by anyone outside the team.
DEBUG=

# Shared secret that unlocks /_dev/login?as=<handle>&key=<this> even when
# DEBUG is off — a stupid-simple stand-in for real auth so testers can log
# in as any handle without SMTP/OAuth set up. Leave blank to disable.
PLAYTEST_LOGIN_KEY=
