# Font chunks (cn-font-split output) + monolithic fonts: binary blobs, embedded
# via go:embed at build. Mark binary so git skips diffing, vendored so they
# don't skew language stats.
*.woff2 binary linguist-vendored
*.otf   binary linguist-vendored
*.ttf   binary linguist-vendored

# templ embeds source newlines inside generated Go string literals. Keep both
# inputs and outputs on LF so generation is identical on Windows and Linux CI.
*.templ    text eol=lf
*_templ.go text eol=lf
